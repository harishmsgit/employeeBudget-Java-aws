# Copy this file to terraform.tfvars and fill in real values before running plan/apply.
# Do NOT commit terraform.tfvars to git.

aws_region       = "ap-south-1"
environment      = "dev"
eks_cluster_name = "webapp-eks-cluster"
node_group_name  = "JavaSpringNG"

# Networking — replace with real VPC/subnet IDs
vpc_id             = "vpc-REPLACE_WITH_YOUR_VPC_ID"
private_subnet_ids = ["subnet-REPLACE_1", "subnet-REPLACE_2"]
public_subnet_ids  = ["subnet-REPLACE_PUB1", "subnet-REPLACE_PUB2"]

# Security groups
lambda_security_group_ids = ["sg-REPLACE_WITH_LAMBDA_SG"]
batch_security_group_ids  = ["sg-REPLACE_WITH_BATCH_SG"]

# S3 bucket for batch archives
archive_s3_bucket = "dda-dev-archive-495013583028"

# Secrets Manager ARN for DB credentials
db_secret_arn = "arn:aws:secretsmanager:ap-south-1:495013583028:secret:dda-dev-db-XXXXX"

# RDS endpoint
db_host = "REPLACE_WITH_RDS_ENDPOINT"
db_name = "app_db"
db_user = "postgres"

# SNS topic ARN for alerts (leave empty string if not used)
sns_topic_arn = ""

# EventBridge cron for nightly batch (UTC)
batch_nightly_cron = "cron(0 1 * * ? *)"

# ECR repositories to create
ecr_repositories = ["employee-service", "project-service", "budget-service", "batch-night-job"]
